{
  "name": "promptsyntax",
  "version": "0.1.0",
  "description": "A provenance-aware parser for Prompt Syntax",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/pathscale/PromptSyntax-ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.3.14",
    "typescript": "5.7.2"
  }
}
