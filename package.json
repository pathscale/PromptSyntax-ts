{
  "name": "promptsyntax",
  "version": "0.1.0",
  "description": "A provenance-aware parser for Prompt Syntax",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathscale/PromptSyntax-ts.git"
  },
  "homepage": "https://github.com/pathscale/PromptSyntax-ts#readme",
  "bugs": "https://github.com/pathscale/PromptSyntax-ts/issues",
  "keywords": [
    "prompt",
    "parser",
    "ai",
    "control-plane"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "core-adapter": "bun src/bin/core-adapter.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.3.14",
    "typescript": "5.7.2"
  }
}
